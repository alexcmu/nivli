# Railway: add PostgreSQL, then reference its DATABASE_URL in the web service.
DATABASE_URL=${{Postgres.DATABASE_URL}}
# Generate once with: openssl rand -hex 32
ADMIN_SECRET=
# Use your server-side Anthropic API key; never put it in the iPhone app.
ANTHROPIC_API_KEY=
MODEL_ID=claude-sonnet-5-5
MODEL_DAILY_BUDGET_USD=1
MODEL_MAX_OUTPUT_TOKENS=1024
ENVIRONMENT_NAME=My Haiji
PUSH_MODE=disabled
PORT=3000
# PUBLIC_URL is discovered from Railway's generated public domain.

# Optional self-signed remote notifications; key stays on the server.
# PUSH_MODE=self_signed
# APNS_TEAM_ID=ABCDEFGHIJ
# APNS_KEY_ID=0123456789
# APNS_TOPIC=app.haiji.Haiji
# APNS_ENVIRONMENT=development
# APNS_KEY_FILE=/run/secrets/apns_key

# Replace APP_IMAGE with a CI-published immutable reference. No release exists yet.
APP_IMAGE=ghcr.io/your-owner/haiji@sha256:REPLACE_WITH_RELEASE_DIGEST
# Hex avoids URL-special characters in DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
# Existing volumes must use their original database and role names.
POSTGRES_USER=haiji
POSTGRES_DB=haiji
# Absolute path; file must be readable by container UID 1000.
ADMIN_SECRET_PATH=/absolute/path/to/admin-secret
PUBLIC_URL=https://haiji.example.com
ENVIRONMENT_NAME=My Haiji
PUSH_MODE=disabled
MODEL_DATA_DESTINATION=No model configured
API_PORT=3000
